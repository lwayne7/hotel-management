{
    "version": 2,
    "buildCommand": "cd frontend && npm install && npm run build",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://hotel-management-production-wayne.up.railway.app/api/:path*"
        },
        {
            "source": "/socket.io/:path*",
            "destination": "https://hotel-management-production-wayne.up.railway.app/socket.io/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}